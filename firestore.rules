rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEvent(eventId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'title', 'date', 'time', 'category', 'note'])
        && data.keys().hasOnly(['id', 'title', 'date', 'time', 'category', 'note'])
        && data.id == eventId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.matches('^([0-9]{2}:[0-9]{2})?$')
        && data.category in ['work', 'life', 'important']
        && data.note is string && data.note.size() <= 240;
    }

    match /users/{userId}/events/{eventId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validEvent(eventId);
      allow delete: if isOwner(userId);
    }
  }
}
